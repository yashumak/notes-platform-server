{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --check index.js",
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed:admin": "node scripts/seed-admin.js",
    "migrate:s3": "node scripts/migrate-to-s3.js",
    "migrate:s3-metadata-to-mongo": "node --env-file=.env scripts/migrate-s3-metadata-to-mongodb.js --apply",
    "migrate:s3-metadata-to-mongo:dry": "node --env-file=.env scripts/migrate-s3-metadata-to-mongodb.js --dry-run",
    "migrate:s3-metadata:dry": "node --env-file=.env scripts/sync-s3-metadata.js --dry-run",
    "migrate:s3-metadata:backup": "node --env-file=.env scripts/sync-s3-metadata.js --backup",
    "migrate:s3-metadata": "node --env-file=.env scripts/sync-s3-metadata.js --apply",
    "verify:s3-metadata": "node --env-file=.env scripts/sync-s3-metadata.js --verify",
    "test": "node --test test/*.test.js",
    "test:security": "node --test test/security.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11"
  }
}
