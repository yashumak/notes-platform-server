PORT=5000
NODE_ENV=development
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-private-secret-at-least-32-bytes-long
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

# Rate limiting; configure REDIS_URL for shared limits across backend instances.
# Production startup requires REDIS_URL. Use a private Redis/ElastiCache endpoint.
REDIS_URL=
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_LOGIN_IP_WINDOW_MS=60000
RATE_LIMIT_LOGIN_IP_MAX=5
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=60000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_PASSWORD_CHANGE_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_CHANGE_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_OTP_VERIFICATION_WINDOW_MS=600000
RATE_LIMIT_OTP_VERIFICATION_MAX=5
RATE_LIMIT_NOTES_UPLOAD_WINDOW_MS=600000
RATE_LIMIT_NOTES_UPLOAD_MAX=10
RATE_LIMIT_NOTES_SEARCH_WINDOW_MS=60000
RATE_LIMIT_NOTES_SEARCH_MAX=30
RATE_LIMIT_PUBLIC_NOTES_LIST_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_NOTES_LIST_MAX=60

# AWS S3 storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
MAX_NOTE_FILE_SIZE_BYTES=52428800

# Scraper identity — displayed as uploadedBy in note records
SCRAPER_UPLOADER_ID=scraper-bot
